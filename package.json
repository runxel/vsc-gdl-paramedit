{
  "name": "gdl-parameter-editor",
  "displayName": "GDL Parameter Editor",
  "description": "Visual Editor for GDL `paramlist.xml` files.",
  "version": "0.8.0",
  "publisher": "runxel",
  "repository": {
    "type": "git",
    "url": "https://github.com/runxel/vsc-gdl-paramedit.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "gdl.parameterEditor",
        "displayName": "GDL Parameter Editor",
        "selector": [
          {
            "filenamePattern": "**/paramlist.xml"
          },
          {
            "filenamePattern": "**/Parameters.xml"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "{git,gitlens}:/**/paramlist.xml": "default",
        "{git,gitlens}:/**/Parameters.xml": "default"
      }
    },
    "commands": [
      {
        "command": "gdl.parameterEditor.copy",
        "title": "Kopieren"
      },
      {
        "command": "gdl.parameterEditor.paste",
        "title": "Einfügen"
      },
      {
        "command": "gdl.parameterEditor.duplicate",
        "title": "Duplizieren"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gdl.parameterEditor.copy",
          "when": "false"
        },
        {
          "command": "gdl.parameterEditor.paste",
          "when": "false"
        },
        {
          "command": "gdl.parameterEditor.duplicate",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "gdl.parameterEditor.copy",
          "when": "webviewId == 'gdl.parameterEditor' && webviewSection == 'param'",
          "group": "1_cutcopy@1"
        },
        {
          "command": "gdl.parameterEditor.paste",
          "when": "webviewId == 'gdl.parameterEditor' && (webviewSection == 'param' || webviewSection == 'list')",
          "group": "1_cutcopy@2"
        },
        {
          "command": "gdl.parameterEditor.duplicate",
          "when": "webviewId == 'gdl.parameterEditor' && webviewSection == 'param'",
          "group": "1_cutcopy@3"
        }
      ]
    }
  },
  "scripts": {
    "test": "node test/roundtrip.js && node test/mutate.js && node test/structure.js && node test/arrays.js && node test/roundtrip-all.js",
    "test:roundtrip": "node test/roundtrip.js",
    "test:mutate": "node test/mutate.js",
    "test:structure": "node test/structure.js",
    "test:all": "node test/roundtrip-all.js",
    "test:arrays": "node test/arrays.js"
  },
  "icon": "media/icon.png"
}